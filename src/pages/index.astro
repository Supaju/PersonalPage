---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechFilter from '../components/TechFilter.astro';
import Footer from '../components/Footer.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const techs = [...new Set(projects.flatMap((p) => p.data.tech))].sort();
---
<Base title="Andrew Chait - Backend & Full-Stack Engineer">
  <Header />
  <main id="top" class="wrap">
    <Hero />

    <section id="projects" class="reveal">
      <h2>ls projects/</h2>
      {projects.length > 2 && <TechFilter techs={techs} />}
      <div class="grid">
        {projects.map((p) => (
          <ProjectCard slug={p.id} title={p.data.title} summary={p.data.summary} tech={p.data.tech} metric={p.data.metric} image={p.data.image} demo={p.data.demo} repo={p.data.repo} />
        ))}
      </div>
    </section>

    <section id="work" class="reveal">
      <h2>git log --career</h2>
      <div class="log">
        {work.map((w) => (
          <div class="commit">
            <div class="hash">{w.data.period}</div>
            <h3>{w.data.role}, {w.data.title}</h3>
            {w.data.metric && <span class="callout">{w.data.metric}</span>}
            <p>{w.data.summary}</p>
            {w.data.tech.length > 0 && <div class="tags">{w.data.tech.map((t) => <span>{t}</span>)}</div>}
            <a class="mono" href={`/work/${w.id}/`}>read case study →</a>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class="reveal about">
      <h2>cat about.md</h2>
      <p>I'm a full-stack developer who has spent eight years at SAS, starting as an intern in 2018, getting dropped into early-stage products and helping them reach market. Most recently that meant SAS AI Navigator, built in Go and React with Claude agents driving the work. The stack changes every time; my job is to learn whatever it needs and ship something that works.</p>
      <p>Outside of work I hike, play video games, and keep up with the latest technology so I'm not caught off guard by what the market asks for. Mostly the hiking, though. The terminal has no trees.</p>
      <p class="mono" style="color:var(--muted);font-size:14px">skills: Go, Python, agentic workflows, React, PostgreSQL / SQL, Docker, Kubernetes, Terraform</p>
      <p><a class="btn" href="/resume.pdf">resume.pdf</a></p>
    </section>

    <section id="education" class="reveal">
      <h2>cat education.txt</h2>
      <p class="mono">B.S. Computer Science · Hobart and William Smith Colleges · 2019</p>
    </section>
  </main>
  <Footer />
</Base>
